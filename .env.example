# ==============================================================================
# AgriSense AI - Environment Configuration Template
# NOTE: Never commit sensitive passwords, secret keys, or database credentials.
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Security Secret Key (Used for session / JWT signature validation in shared auth)
SECRET_KEY=dev-secret-key-change-in-production-agrisense-2026

# Shared Backend API Base URL
API_BASE_URL=http://localhost:8000

# Shared Database Connection String (PostgreSQL)
# Format: postgresql+psycopg://username:password@hostname:port/database_name
# Coordinate with Dhyan (Platform & Database Lead) for team connection credentials
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agrisense_db

# Fertilizer Model Version
FERTILIZER_MODEL_VERSION=1.0.0
